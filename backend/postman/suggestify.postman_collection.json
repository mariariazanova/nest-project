	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Signup (POST /v1/auth/users)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const jsonData = pm.response.json();",
									"const authData = jsonData.data || jsonData;",
									"if (authData.accessToken) {",
									"    pm.environment.set('accessToken', authData.accessToken);",
									"    pm.collectionVariables.set('accessToken', authData.accessToken);",
									"}",
									"if (authData.user && authData.user.id) {",
									"    pm.environment.set('userId', authData.user.id);",
									"    pm.collectionVariables.set('userId', authData.user.id);",
									"}",
									"// store HATEOAS links",
									"if (jsonData.links) {",
									"    pm.environment.set('links', JSON.stringify(jsonData.links));",
									"    if (jsonData.links.sessions) pm.environment.set('sessionsUrl', jsonData.links.sessions);",
									"    if (jsonData.links.favorites) pm.environment.set('favoritesUrl', jsonData.links.favorites);",
									"    if (jsonData.links.history) pm.environment.set('historyUrl', jsonData.links.history);",
									"    if (jsonData.links.suggestions) pm.environment.set('suggestionsUrl', jsonData.links.suggestions);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"user\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/auth/users",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "auth", "users"]
						}
					},
					"response": []
				},
