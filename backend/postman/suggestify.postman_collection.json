				{
					"name": "Logout (DELETE /v1/auth/sessions)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 204) {",
									"    pm.environment.unset('accessToken');",
									"    pm.collectionVariables.unset('accessToken');",
									"    pm.environment.unset('userId');",
									"    pm.collectionVariables.unset('userId');",
									"    pm.environment.unset('links');",
									"    pm.environment.unset('sessionsUrl');",
									"    pm.environment.unset('favoritesUrl');",
									"    pm.environment.unset('historyUrl');",
									"    pm.environment.unset('suggestionsUrl');",
									"}"
								],
