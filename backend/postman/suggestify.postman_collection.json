		{
			"name": "History",
			"item": [
				{
					"name": "Get User History (GET /v1/history)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    const historyData = jsonData.data || jsonData;",
									"    const items = Array.isArray(historyData) ? historyData : (historyData.items || historyData);",
									"    if (Array.isArray(items) && items.length > 0) {",
									"        pm.environment.set('historyItemId', items[0]._id);",
									"    } else {",
									"        pm.environment.unset('historyItemId');",
									"    }",
									"    // store HATEOAS links",
									"    if (jsonData.links) {",
									"        if (jsonData.links.favorites) pm.environment.set('favoritesUrl', jsonData.links.favorites);",
									"        if (jsonData.links.suggestions) pm.environment.set('suggestionsUrl', jsonData.links.suggestions);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
