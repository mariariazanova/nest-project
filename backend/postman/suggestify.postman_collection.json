		{
			"name": "Suggestions",
			"item": [
				{
					"name": "Get Film Suggestions (GET /v1/suggestion)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    const suggestion = jsonData.data || jsonData;",
									"    if (suggestion.type) pm.environment.set('category', suggestion.type);",
									"    if (suggestion.items && suggestion.items.length > 0) {",
									"        pm.environment.set('itemId', suggestion.items[0].id);",
									"    } else {",
									"        pm.environment.unset('itemId');",
									"    }",
									"    // store HATEOAS links",
									"    if (jsonData.links) {",
									"        if (jsonData.links.favorites) pm.environment.set('favoritesUrl', jsonData.links.favorites);",
									"        if (jsonData.links.history) pm.environment.set('historyUrl', jsonData.links.history);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{accessToken}}"},
							{"key": "X-User-Id", "value": "{{userId}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/v1/suggestion?category=films&mood=relaxing&genre=sci-fi&event=discovery",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "suggestion"],
							"query": [
								{"key": "category", "value": "films"},
								{"key": "mood", "value": "relaxing"},
								{"key": "genre", "value": "sci-fi"},
								{"key": "event", "value": "discovery"}
							]
						}
					},
					"response": []
				},
