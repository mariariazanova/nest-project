# Node Environment
NODE_ENV=development
PORT=3000

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispass

# Consul Service Discovery
CONSUL_HOST=consul
CONSUL_PORT=8500

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://rabbit:rabbitpass@rabbitmq:5672

# Service URLs (fallback if Consul fails)
AUTH_SERVICE_URL=http://auth-service:3001
SUGGESTION_SERVICE_URL=http://suggestion-service:3002
HISTORY_SERVICE_URL=http://history-service:3003

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Service Host (for Consul registration)
SERVICE_HOST=api-gateway
