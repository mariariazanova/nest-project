# Node Environment
NODE_ENV=development
PORT=3003

# MongoDB
MONGODB_URI=mongodb://root:rootpass@mongodb:27017/history_db?authSource=admin

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Consul Service Discovery
CONSUL_HOST=consul
CONSUL_PORT=8500

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://rabbit:rabbitpass@rabbitmq:5672

# Service URLs (fallback)
AUTH_SERVICE_URL=http://auth-service:3001
SUGGESTION_SERVICE_URL=http://suggestion-service:3002
HISTORY_SERVICE_URL=http://history-service:3003

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Service Host (for Consul registration)
SERVICE_HOST=history-service
