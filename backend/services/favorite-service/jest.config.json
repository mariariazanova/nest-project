{
  "moduleFileExtensions": ["ts", "js"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "testEnvironment": "node",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "**/*.(t|j)s"
  ],
  "coverageDirectory": "../coverage",
  "globals": {
    "ts-jest": {
      "tsconfig": "tsconfig.json"
    }
  }
}
