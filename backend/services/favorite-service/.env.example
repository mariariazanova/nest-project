# Node Environment
NODE_ENV=development
PORT=3004

# PostgreSQL Database
DB_HOST=postgres-favorites
DB_PORT=5432
DB_NAME=favorites_db
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Consul Service Discovery
CONSUL_HOST=consul
CONSUL_PORT=8500

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://rabbit:rabbitpass@rabbitmq:5672

# Service URLs (fallback)
FAVORITE_SERVICE_URL=http://favorite-service:3004

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Service Host (for Consul registration)
SERVICE_HOST=favorite-service
