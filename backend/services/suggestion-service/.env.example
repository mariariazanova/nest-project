# Node Environment
NODE_ENV=development
PORT=3002

# PostgreSQL Database
DB_HOST=postgres-suggestions
DB_PORT=5432
DB_NAME=suggestions_db
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Consul Service Discovery
CONSUL_HOST=consul
CONSUL_PORT=8500

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://rabbit:rabbitpass@rabbitmq:5672

# Service URLs (fallback)
HISTORY_SERVICE_URL=http://history-service:3003

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Service Host (for Consul registration)
SERVICE_HOST=suggestion-service
