# Multi-stage build for Angular frontend with Nx

# Stage 1: Builder
FROM node:20-alpine AS builder

WORKDIR /app

# Copy workspace files
COPY package*.json ./
COPY tsconfig*.json ./
COPY nx.json ./

# Install dependencies
RUN npm config set fetch-timeout 600000 && npm ci

# Copy frontend source
COPY apps/frontend ./apps/frontend

# Build frontend with Nx
RUN npx nx build frontend --prod

# Stage 2: Production with Nginx
FROM nginx:alpine AS production

# Copy built app to nginx
COPY --from=builder /app/dist/apps/frontend/browser /usr/share/nginx/html

# Copy custom nginx config if needed
# COPY backend/infrastructure/nginx.conf /etc/nginx/conf.d/default.conf

# Expose ports
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
