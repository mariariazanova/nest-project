    "@angular/platform-browser-dynamic": "~22.0.4",
    "@eslint/js": "^10.0.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.27",
    "@nx/docker": "23.1.0-beta.4",
    "@nx/eslint": "23.1.0-beta.4",
    "@nx/eslint-plugin": "23.1.0-beta.4",
    "@nx/jest": "23.1.0-beta.4",
    "@nx/js": "23.1.0-beta.4",
    "@nx/nest": "^23.1.0-beta.4",
    "@nx/node": "23.1.0-beta.4",
    "@nx/web": "23.1.0-beta.4",
    "@nx/webpack": "23.1.0-beta.4",
    "@swc/helpers": "~0.5.18",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.2",
    "@types/opossum": "^8.1.9",
    "@types/passport-jwt": "^4.0.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.0.8",
    "angular-eslint": "^22.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-playwright": "^2.10.4",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jsdom": "^29.1.1",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^17.0.8",
    "nx": "23.1.0-beta.4",
    "prettier": "~3.6.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.0.8",
    "webpack": "^5.108.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.1"
  },
  "lint-staged": {
    "*.{ts,js,html}": [
