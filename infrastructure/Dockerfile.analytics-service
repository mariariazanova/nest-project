ARG SERVICE_NAME=analytics-service
ARG SERVICE_PORT=3007

FROM node:24-alpine AS builder
ARG SERVICE_NAME

WORKDIR /app

COPY package*.json ./
COPY tsconfig*.json ./
COPY nx.json ./

RUN npm config set fetch-timeout 600000 && npm ci

COPY apps/${SERVICE_NAME} ./apps/${SERVICE_NAME}
COPY libs ./libs

RUN npx nx build ${SERVICE_NAME} --prod

RUN npm prune --omit=dev

FROM node:24-alpine AS production
ARG SERVICE_NAME
ARG SERVICE_PORT

RUN apk add --no-cache dumb-init

WORKDIR /app

RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

COPY package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist/apps/${SERVICE_NAME} ./dist

RUN chown -R nodejs:nodejs ./dist
USER nodejs

EXPOSE ${SERVICE_PORT}

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:${SERVICE_PORT}/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main.js"]
