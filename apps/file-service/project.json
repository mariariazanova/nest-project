{
  "name": "file-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/file-service/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "env": {
          "NODE_ENV": "production"
        },
        "cwd": "apps/file-service"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/file-service/package.json",
        "{workspaceRoot}/dist/apps/file-service/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/file-service/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/file-service"],
      "options": {
        "jestConfig": "apps/file-service/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "migration:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx typeorm-ts-node-commonjs migration:generate src/migrations/{args.name} -d src/data-source.ts",
        "cwd": "apps/file-service",
        "env": { "TS_NODE_PROJECT": "tsconfig.app.json" }
      }
    },
    "migration:run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
        "cwd": "apps/file-service",
        "env": { "TS_NODE_PROJECT": "tsconfig.app.json" }
      }
    },
    "migration:revert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
        "cwd": "apps/file-service",
        "env": { "TS_NODE_PROJECT": "tsconfig.app.json" }
      }
    },
    "migration:show": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx typeorm-ts-node-commonjs migration:show -d src/data-source.ts",
        "cwd": "apps/file-service",
        "env": { "TS_NODE_PROJECT": "tsconfig.app.json" }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "file-service:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "file-service:build:development"
        },
        "production": {
          "buildTarget": "file-service:build:production"
        }
      }
    }
  },
  "tags": []
}
